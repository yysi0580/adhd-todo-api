APP_NAME=ADHD Todo API
DATABASE_URL=sqlite:///./adhd_todo.db
ENVIRONMENT=local
AUTO_CREATE_TABLES=true
JWT_SECRET_KEY=change-this-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
LOGIN_FAILURE_LIMIT=5
LOGIN_BLOCK_MINUTES=5
LOGIN_RATE_LIMIT_PER_MINUTE=20
BRAIN_DUMP_RATE_LIMIT_PER_MINUTE=60
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://yangtheory.site:5173
OPENAI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_SUGGESTION_ENABLED=false
